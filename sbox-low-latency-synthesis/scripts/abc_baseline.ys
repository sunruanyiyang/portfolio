# abc_baseline.ys
# Baseline Yosys + ABC synthesis flow (originally run_opt.ys).
# Reads the original full S-box (SB.v) and runs a plain ABC script
# (default script) to establish the unoptimized baseline:
#   yosys -s scripts/abc_baseline.ys
read_verilog rtl/SB.v

hierarchy -top SB

proc
opt

flatten
opt

abc

opt

stat

show -format dot -prefix result/sb_opt
